{
  "manifest_version": 3,
  "name": "Human Typer",
  "version": "1.5.0",
  "minimum_chrome_version": "118",
  "description": "将草稿逐字输入到网页，支持 Google Docs、Sheets、Slides、Gmail、Forms、Keep 和 Drive。",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead",
    "sidePanel",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Human Typer",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
